aws_region = "ap-southeast-2"
name_prefix = "cod"

# Replace with the Marketplace ECR digest from the COD listing.
# Published Marketplace image 1.0.4 (multi-arch index).
container_image = "709825985650.dkr.ecr.us-east-1.amazonaws.com/yuma-it/cod-aws@sha256:e93c81a4bd42a1e36c760a48a12709736b0a291ab4003bd669b43f91152fe4e5"

# Signed JWT issued for this buyer. Do not commit the real value.
license_key = "REPLACE_WITH_SIGNED_JWT"

# Optional. Empty uses the internal ALB DNS name.
domain = ""

# Optional VPN / shared-services CIDRs. Empty = VPC CIDR only.
# 0.0.0.0/0 and ::/0 are rejected. This stack is not internet-facing.
allowed_ingress_cidrs = []
